; Engine configuration file.
config_version=5

[application]
config/name="PlanetaFactory"
config/description="Jogo de automação em planeta vivo (PC e celular)."
run/main_scene="res://cenas/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"

[autoload]
Registro="*res://nucleo/registro.gd"
Sessao="*res://nucleo/sessao.gd"
Som="*res://nucleo/som.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=30

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[shader_globals]

nuvem_ruido={
"type": "sampler2D",
"value": "res://assets/texturas/ruido_detalhe.png"
}
nuvem_cobertura={
"type": "float",
"value": 0.0
}
nuvem_deslocamento={
"type": "vec2",
"value": Vector2(0, 0)
}
molhado={
"type": "float",
"value": 0.0
}
pocas={
"type": "float",
"value": 0.0
}
chuva_agora={
"type": "float",
"value": 0.0
}
sol_dir={
"type": "vec3",
"value": Vector3(0.44, 0.63, 0.64)
}
nuvem_mapa={
"type": "sampler2D",
"value": "res://assets/texturas/nuvens.png"
}
visao_recursos={
"type": "float",
"value": 0.0
}
piso_crescer={
"type": "vec3",
"value": Vector3(0, 0, 1e+06)
}
alvo_camera={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
vento_dir={
"type": "vec2",
"value": Vector2(1, 0)
}
rajada={
"type": "vec3",
"value": Vector3(-1e+06, 0, 12)
}
estacao_atual={
"type": "float",
"value": 0.5
}
visao_oval={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
visao_raios={
"type": "vec2",
"value": Vector2(1e+06, 1e+06)
}
visao_mapa={
"type": "sampler2D",
"value": ""
}
grade_construcao={
"type": "vec4",
"value": Vector4(0, 0, 16, 0)
}
visao_mapa_origem={
"type": "vec3",
"value": Vector3(0, 0, 256)
}
fogo_mapa={
"type": "sampler2D",
"value": ""
}
fogo_origem={
"type": "vec2",
"value": Vector2(0, 0)
}
